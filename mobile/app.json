{
  "expo": {
    "name": "Twain",
    "slug": "twain",
    "scheme": "twain",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7FB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.g41us.twain"
    },
    "android": {
      "package": "com.g41us.twain",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#B42EB3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Twain uses the microphone to record your voice intro."
        }
      ],
      "expo-image",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#140A18"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Twain uses your photos so you can add them to your profile.",
          "cameraPermission": "Twain uses the camera for your verification selfie."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Twain uses your location to show people near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF2D6F"
        }
      ],
      "./plugins/with-release-signing"
    ]
  }
}
