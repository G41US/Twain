DATABASE_URL="postgresql://..."
NEXTAUTH_SECRET="superlongrandomstringhere"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxx"

# Photo + voice uploads use Supabase Storage. The project URL and public anon key are
# built into lib/supabase.ts; set these only to point at a different Supabase project.
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# AI wingman — any OpenAI-compatible API. Defaults to xAI (Grok).
WINGMAN_API_KEY="xai-..."
# WINGMAN_API_URL="https://api.x.ai/v1"
# WINGMAN_MODEL="grok-3-mini"

# Local testing only (npm run dev): sign in as seeded users without Google
# DEMO_LOGIN="true"
