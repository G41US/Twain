generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  age             Int?
  bio             String?   @db.VarChar(500)
  gender          String?   @db.VarChar(50)
  lookingFor      String?   @db.VarChar(50)
  ethnicity       String?   @db.VarChar(50)
  preferEthnicity String?   @default("all") @db.VarChar(50)
  photos          String[]  // URLs
  voiceIntroUrl   String?
  traits          String[]  // my lifestyle (e.g. "smokes"); matched against others' dealbreakers
  dealbreakers    String[]  // traits I won't date
  vibeAnswers     Json?
  latitude        Float?    // rounded to ~1km before saving
  longitude       Float?
  maxDistanceKm   Int       @default(50)
  ageMin          Int       @default(18)
  ageMax          Int       @default(60)
  acceptedTermsAt DateTime?
  sensitiveConsentAt DateTime? // explicit consent to store ethnicity (NDPA sensitive data)
  verified        Boolean   @default(false)
  selfieUrl       String?
  selfiePose      String?   @db.VarChar(100)
  selfieStatus    String?   @db.VarChar(20) // pending | rejected
  photosUpdatedAt DateTime?
  replyRate       Float?    // null until someone has messaged them
  isAdmin         Boolean   @default(false)
  banned          Boolean   @default(false)
  lastActiveAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts Account[]
  likesGiven Like[]     @relation("LikesGiven")
  likesReceived Like[]  @relation("LikesReceived")
  matchesAsUser1 Match[] @relation("MatchUser1")
  matchesAsUser2 Match[] @relation("MatchUser2")
  messages       Message[]
  blocksMade     Block[]  @relation("BlocksMade")
  blocksReceived Block[]  @relation("BlocksReceived")
  reportsMade    Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")
  passesGiven    Pass[]   @relation("PassesGiven")
  passesReceived Pass[]   @relation("PassesReceived")
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([latitude, longitude])
  @@index([age])
  @@index([ethnicity])
}

model Like {
  id        String   @id @default(cuid())
  likerId   String
  likedId   String
  createdAt DateTime @default(now())

  liker User @relation("LikesGiven", fields: [likerId], references: [id], onDelete: Cascade)
  liked User @relation("LikesReceived", fields: [likedId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedId])
}

model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1    User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String   @db.VarChar(500)
  createdAt  DateTime @default(now())

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
}

// One-time permission to upload a single file to Supabase Storage (see lib/supabase.ts).
model UploadTicket {
  path      String   @id
  userId    String
  expiresAt DateTime

  @@index([userId, expiresAt])
}

model Pass {
  id        String   @id @default(cuid())
  passerId  String
  passedId  String
  createdAt DateTime @default(now())

  passer User @relation("PassesGiven", fields: [passerId], references: [id], onDelete: Cascade)
  passed User @relation("PassesReceived", fields: [passedId], references: [id], onDelete: Cascade)

  @@unique([passerId, passedId])
}

model PushSubscription {
  endpoint  String   @id
  userId    String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Storage paths (or "folder/" prefixes) waiting to be deleted by the purge-media edge function.
model MediaDeletion {
  path      String   @id
  createdAt DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String   @db.VarChar(20) // server | client
  message   String   @db.VarChar(1000)
  path      String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
